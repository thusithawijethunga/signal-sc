{
  "info": {
    "name": "Signal Xpress - Community Post Approval",
    "description": "Complete API collection for the Community Post Approval flow.\n\n## Authentication\nAll endpoints require a Bearer token or X-Api-Token header.\nLogin first to obtain a token.\n\n## Flow\n1. Login (POST /auth/login)\n2. Create Post (POST /community/posts) → status: pending\n3. Admin views pending posts (GET /admin/community/pending-posts)\n4. Admin approves (POST /admin/community/posts/{id}/approve)\n5. Post becomes visible to all users",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "signal-xpress"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://your-domain.com/api",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "post_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "comment_id",
      "value": "1",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('auth_token', jsonData.token);",
                  "    pm.test('Login successful', () => {",
                  "        pm.expect(pm.response.code).to.equal(200);",
                  "        pm.expect(jsonData.token).to.not.be.null;",
                  "    });",
                  "} else {",
                  "    pm.test('Login failed', () => {",
                  "        pm.expect(pm.response.code).to.not.equal(200);",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            }
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["auth", "logout"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Community Posts (User)",
      "item": [
        {
          "name": "Get Community Posts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/community/posts?per_page=20",
              "host": ["{{base_url}}"],
              "path": ["community", "posts"],
              "query": [
                {
                  "key": "post_type",
                  "value": "",
                  "description": "Filter: text, trade_update, screenshot, signal_card",
                  "disabled": true
                },
                {
                  "key": "pair",
                  "value": "",
                  "description": "Filter by trading pair",
                  "disabled": true
                },
                {
                  "key": "search",
                  "value": "",
                  "description": "Search content, author name, hashtags",
                  "disabled": true
                },
                {
                  "key": "status",
                  "value": "",
                  "description": "Filter by status (admin only)",
                  "disabled": true
                },
                {
                  "key": "per_page",
                  "value": "20",
                  "description": "Results per page"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create Post (Text)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Great trade setup on GBPUSD! Waiting for breakout above 1.2500\",\n  \"post_type\": \"text\",\n  \"hashtags\": \"#forex #GBPUSD #setup\",\n  \"pair\": \"GBPUSD\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/community/posts",
              "host": ["{{base_url}}"],
              "path": ["community", "posts"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('Post created', () => {",
                  "    pm.expect(pm.response.code).to.equal(201);",
                  "    pm.expect(jsonData.post).to.not.be.null;",
                  "    pm.expect(jsonData.status).to.be.oneOf(['pending', 'approved']);",
                  "    if (jsonData.post && jsonData.post.id) {",
                  "        pm.collectionVariables.set('post_id', jsonData.post.id.toString());",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Post (Trade Update / Profit Card)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Closed GBPUSD buy for +100 pips profit!\",\n  \"post_type\": \"trade_update\",\n  \"pair\": \"GBPUSD\",\n  \"trade_type\": \"buy\",\n  \"entry_price\": \"1.2500\",\n  \"exit_price\": \"1.2600\",\n  \"lot_size\": \"0.10\",\n  \"profit_amount\": 100.00,\n  \"pips_gain\": 100,\n  \"roi_percentage\": 10.0,\n  \"broker_name\": \"XM\",\n  \"card_theme\": \"dark\",\n  \"is_verified_trade\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/community/posts",
              "host": ["{{base_url}}"],
              "path": ["community", "posts"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('Trade update post created', () => {",
                  "    pm.expect(pm.response.code).to.equal(201);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Post (Screenshot)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Screenshot of my chart analysis\",\n  \"post_type\": \"screenshot\",\n  \"hashtags\": \"#analysis #chart\",\n  \"image_uri\": \"https://example.com/screenshot.png\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/community/posts",
              "host": ["{{base_url}}"],
              "path": ["community", "posts"]
            }
          },
          "response": []
        },
        {
          "name": "Delete Post",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/community/posts/{{post_id}}",
              "host": ["{{base_url}}"],
              "path": ["community", "posts", "{{post_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "React to Post",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"emoji\": \"thumbs\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/community/posts/{{post_id}}/react",
              "host": ["{{base_url}}"],
              "path": ["community", "posts", "{{post_id}}", "react"]
            }
          },
          "response": []
        }
      ]
    },
